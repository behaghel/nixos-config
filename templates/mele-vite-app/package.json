{
  "name": "example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "check": "tsc -b && vitest --run",
    "test": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.27.2",
    "vitest": "4.1.6"
  }
}
