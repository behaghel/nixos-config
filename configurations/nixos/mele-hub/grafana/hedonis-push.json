  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Push subscriptions",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "none" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "start", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "text": {}, "textMode": "value_and_name" },
      "targets": [{ "expr": "hedonis_push_subscriptions_total{app=\"hedonis\"}", "refId": "A", "legendFormat": "subscriptions" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Wake intents",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] }, "unit": "none" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "start", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "text": {}, "textMode": "value_and_name" },
      "targets": [{ "expr": "hedonis_push_wake_intents_total{app=\"hedonis\"}", "refId": "A", "legendFormat": "{{state}}" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Push failures / 1h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "none" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "start", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "text": {}, "textMode": "value_and_name" },
      "targets": [{ "expr": "sum(increase(hedonis_push_send_total{app=\"hedonis\",status=\"failed\"}[1h]))", "refId": "A", "legendFormat": "failed" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last successful backend push",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "dateTimeAsIso" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "start", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "text": {}, "textMode": "value_and_name" },
      "targets": [{ "expr": "max(hedonis_push_last_success_timestamp_seconds{app=\"hedonis\"}) * 1000", "refId": "A", "legendFormat": "last success" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Push send rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "custom": {}, "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [{ "expr": "sum by (category, kind, status) (rate(hedonis_push_send_total{app=\"hedonis\"}[5m]))", "refId": "A", "legendFormat": "{{category}} {{kind}} {{status}}" }]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Push send counters",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "custom": {}, "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [{ "expr": "sum by (category, kind, status) (hedonis_push_send_total{app=\"hedonis\"})", "refId": "A", "legendFormat": "{{category}} {{kind}} {{status}}" }]
    }
  ],
